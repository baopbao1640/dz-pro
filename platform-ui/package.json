{
  "name": "platform-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint \"src/**/*.{ts,vue}\" vite.config.ts",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" vite.config.ts --fix",
    "format": "prettier --ignore-path ../.prettierignore --write \"src/**/*.{ts,vue}\" \"*.{json,ts,js}\" \"../docs/**/*.md\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"src/**/*.{ts,vue}\" \"*.{json,ts,js}\" \"../docs/**/*.md\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.7.9",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "pnpm@9.15.3+sha512.1f79bc245a66eb0b07c5d4d83131240774642caaa86ef7d0434ab47c0d16f66b04e21e0c086eb61e62c77efc4d7f7ec071afad3796af64892fae66509173893a"
}
