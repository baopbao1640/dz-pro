<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.core.system.role.mapper.SysRoleMapper">
    <resultMap id="SysRoleResultMap" type="com.platform.core.system.role.domain.SysRole">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="role_key" property="roleKey"/>
        <result column="role_sort" property="roleSort"/>
        <result column="data_scope" property="dataScope"/>
        <result column="menu_check_strictly" property="menuCheckStrictly"/>
        <result column="dept_check_strictly" property="deptCheckStrictly"/>
        <result column="status" property="status"/>
        <result column="del_flag" property="delFlag"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <select id="selectRoleList" resultMap="SysRoleResultMap">
        SELECT id, role_name, role_key, role_sort, data_scope, menu_check_strictly,
               dept_check_strictly, status, del_flag, create_by, create_time, update_by,
               update_time, remark
        FROM sys_role
        WHERE del_flag = '0'
        <if test="query != null and query.roleName != null and query.roleName != ''">
            AND role_name ILIKE CONCAT('%', #{query.roleName}, '%')
        </if>
        <if test="query != null and query.roleKey != null and query.roleKey != ''">
            AND role_key ILIKE CONCAT('%', #{query.roleKey}, '%')
        </if>
        <if test="query != null and query.status != null and query.status != ''">
            AND status = #{query.status}
        </if>
        <if test="query != null and query.createdStartTime != null">
            AND create_time &gt;= #{query.createdStartTime}
        </if>
        <if test="query != null and query.createdEndTime != null">
            AND create_time &lt;= #{query.createdEndTime}
        </if>
        ORDER BY role_sort ASC, id ASC
    </select>

    <select id="selectActiveById" resultMap="SysRoleResultMap">
        SELECT id, role_name, role_key, role_sort, data_scope, menu_check_strictly,
               dept_check_strictly, status, del_flag, create_by, create_time, update_by,
               update_time, remark
        FROM sys_role
        WHERE id = #{id}
          AND del_flag = '0'
    </select>

    <select id="countActiveByRoleKey" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM sys_role
        WHERE role_key = #{roleKey}
          AND del_flag = '0'
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <select id="countAssignedUsers" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM sys_user_role ur
        JOIN sys_user u ON u.id = ur.user_id AND u.del_flag = '0'
        WHERE ur.role_id = #{roleId}
    </select>
</mapper>
